{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connect-four",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /r/<code> and /claude are client-side routes served by index.html
    "not_found_handling": "single-page-application",
    // Only these paths reach the Worker; everything else is static.
    "run_worker_first": ["/api/*", "/mcp", "/mcp/"]
  },
  // ROOMS: one Durable Object per room (game state, players, WebSockets, Claude long-poll - src/room.ts).
  // LEADERBOARD: one global instance with SQLite: accounts, sessions, results (src/leaderboard.ts).
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LEADERBOARD", "class_name": "Leaderboard" },
      // LOBBY: one global instance - site-wide chat + "Live now" list of AI matches (src/lobby.ts)
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Leaderboard"] }, { "tag": "v2", "new_sqlite_classes": ["Lobby"] }]
}
